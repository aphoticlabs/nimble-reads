---
import { url } from '../lib/paths.js';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="color-scheme" content="dark" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>📚</text></svg>" />
  </head>
  <body>
    <header>
      <a class="wordmark" href={url()}>Nimble Reads</a>
      <nav>
        <a href={url('about.html')}>About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Ranked by canon appearances and reader reach. Data from{' '}
        <a href="https://openlibrary.org">Open Library</a>,{' '}
        <a href="https://www.wikidata.org">Wikidata</a>, and Wikipedia.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b0c10;
    --fg: #e9e9ee;
    --muted: #8b8d9b;
    --line: #23252e;
    --accent: #a68cff;
    --accent-soft: rgba(166, 140, 255, 0.14);
    --card: #14161d;
    --card-hover: #1a1d26;
    --read: #5ed2a0;
    --read-bg: rgba(94, 210, 160, 0.12);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    background-image:
      radial-gradient(60rem 32rem at 50% -14rem, rgba(166, 140, 255, 0.16), transparent 70%),
      radial-gradient(44rem 26rem at 88% 4rem, rgba(94, 210, 160, 0.07), transparent 70%);
    background-repeat: no-repeat;
    color: var(--fg);
    font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-text-size-adjust: 100%;
    -webkit-font-smoothing: antialiased;
  }

  a { color: var(--accent); }

  header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: 1rem 1.25rem;
    background: rgba(11, 12, 16, 0.72);
    backdrop-filter: blur(12px);
  }

  header nav a {
    font-size: 0.9rem;
    text-decoration: none;
  }

  header nav a:hover { text-decoration: underline; }

  .wordmark {
    color: var(--fg);
    text-decoration: none;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  main {
    max-width: 52rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  footer {
    border-top: 1px solid var(--line);
    padding: 1.5rem 1.25rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  footer p { max-width: 52rem; margin: 0 auto; }

  h1 {
    font-size: 1.75rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }

  .muted { color: var(--muted); }

  .search {
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: 1rem;
    font-family: inherit;
    color: var(--fg);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search::placeholder { color: var(--muted); }

  .search:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin: 1rem 0 0.5rem;
    font-size: 0.9rem;
  }

  .booklist {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
  }

  .booklist li + li { border-top: 1px solid var(--line); }

  .booklist li[hidden] { display: none; }

  .row {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 0.85rem;
    align-items: baseline;
    padding: 0.8rem 1rem;
    text-decoration: none;
    color: inherit;
    border-left: 2px solid transparent;
    transition: background 0.12s ease, border-color 0.12s ease;
  }

  .row:hover {
    background: var(--card-hover);
    border-left-color: var(--accent);
  }

  .rank {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
  }

  .row .title { font-weight: 550; }

  .row .byline {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .year {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
  }

  .tick {
    color: var(--read);
    font-weight: 700;
    visibility: hidden;
    margin-right: 0.4rem;
  }

  li.is-read .tick { visibility: visible; }
  li.is-read .title { color: var(--muted); }

  .btn {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--fg);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .btn:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .btn[aria-pressed='true'] {
    background: var(--read-bg);
    border-color: var(--read);
    color: var(--read);
    font-weight: 600;
  }

  input[type='checkbox'] { accent-color: var(--accent); }

  .detail .summary {
    font-size: 1.2rem;
    line-height: 1.6;
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
  }

  .detail .summary.empty {
    font-size: 1rem;
    color: var(--muted);
    font-style: italic;
  }

  .meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1.25rem;
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .meta dt { color: var(--muted); }
  .meta dd { margin: 0; font-variant-numeric: tabular-nums; }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    font-size: 0.9rem;
  }

  .empty-state {
    padding: 2rem 0;
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    .row { grid-template-columns: 2.2rem 1fr auto; }
    h1 { font-size: 1.4rem; }
  }
</style>
